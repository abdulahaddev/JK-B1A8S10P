# --- Secrets (never commit) ---
/secrets.yaml
.env
.env.*
!.env.example

# --- ESPHome / PlatformIO build output ---
/.esphome/
.pio/
# OTA images and ELFs from tools/publish_ota.py
/dist/

# --- Dashboard (React + Vite) ---
node_modules/
dashboard/dist/
*.tsbuildinfo
*.local

# --- Python (tools/) ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Editors, AI tools, OS ---
.claude/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Logs from tools (serial captures in logs/ are kept on purpose) ---
npm-debug.log*
*.log.tmp

# --- Serial logs from the board (ESPHome prints failed request URLs, which can carry the Firebase key) ---
logs/ESP Device-logs*.txt
