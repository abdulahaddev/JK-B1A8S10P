# Copy to .env.local (git-ignored). Same values as secrets.yaml.
VITE_FIREBASE_DB_URL=https://<project>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_API_KEY=<firebase web API key>
VITE_FIREBASE_PROJECT_ID=<project id>

# Optional. Remote-control password as a SHA-256 hex digest (default is the sample password 987654321):
#   node -e "console.log(require('crypto').createHash('sha256').update('<password>').digest('hex'))"
# VITE_CONTROL_PASSWORD_SHA256=

# Optional. OTA site for the firmware list, read by the dev/preview server only (never sent to the browser).
# Defaults to ota_base_url / ota_username / ota_password in ../secrets.yaml.
# OTA_BASE_URL=
# OTA_USERNAME=
# OTA_PASSWORD=
